---
import { Marked } from "marked";
import SectionHeading from "../components/SectionHeading.astro";

interface Props {
	kicker?: string;
	title?: string;
	body: readonly string[] | string;
}

const { body, kicker, title } = Astro.props;
const marked = new Marked({ gfm: true, breaks: true });
const markdownContent = Array.isArray(body) ? body.join("\n\n") : body;
const renderedContent = await marked.parse(markdownContent);
---

<section class="mx-auto max-w-4xl px-5 py-16">
	{title && <SectionHeading kicker={kicker} title={title} />}
	<div
		class="space-y-5 text-base leading-8 text-zinc-400 [&_a]:text-blue-400 [&_a:hover]:text-blue-300 [&_code]:rounded [&_code]:bg-white/5 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-xs [&_strong]:font-semibold [&_strong]:text-white [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:mt-1 [&_blockquote]:border-l-2 [&_blockquote]:border-blue-400/30 [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-zinc-400 [&_hr]:border-white/10 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-white [&_h2]:mt-8 [&_h2]:mb-3 [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-white [&_h3]:mt-6 [&_h3]:mb-2 [&_p]:leading-8"
		set:html={renderedContent}
	/>
</section>
