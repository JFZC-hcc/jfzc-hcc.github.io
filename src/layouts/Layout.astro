---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import { getLocaleFromUrl, getSiteConfig, locales } from "../config/site";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const locale = getLocaleFromUrl(Astro.url);
const siteConfig = getSiteConfig(locale);
const { title = siteConfig.name, description = siteConfig.description } =
	Astro.props;

const pageTitle =
	title === siteConfig.name ? title : `${title} | ${siteConfig.name}`;
const background = siteConfig.background;
const rain = background.rain;
const hasImages = background.images && background.images.length > 0;
const backgroundImageUrls = hasImages
	? JSON.stringify(background.images)
	: "[]";
const backgroundInterval = background.interval ?? 8000;
const backgroundOverlayStyle = `background: ${background.overlay}`;
// 双层背景:layer 0 显示当前图,layer 1 预留给下一张做交叉淡入淡出
const layerStyle = (withImage: boolean) => {
	const showImage = hasImages && withImage;
	return [
		`background-image: ${
			showImage ? `url("${background.images[0]}")` : "none"
		}`,
		`filter: blur(${background.blur})`,
		`opacity: ${showImage ? background.opacity : 0}`,
		`transform: scale(${background.scale})`,
		"transition: opacity 1.5s ease-in-out",
	].join("; ");
};
---

<!doctype html>
<html lang={locales[locale].lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />

		<ClientRouter />
		<title>{pageTitle}</title>
	</head>
	<body class="min-h-screen bg-black text-white antialiased">
		<div
			class="pointer-events-none fixed inset-0 z-0 overflow-hidden"
			transition:persist="site-background"
		>
			<div
				id="bg-carousel"
				class="absolute inset-0"
				data-bg-images={backgroundImageUrls}
				data-bg-interval={backgroundInterval}
				data-bg-opacity={hasImages ? background.opacity : 0}
			>
				<div
					class="absolute inset-0 bg-cover bg-center bg-no-repeat"
					data-bg-layer
					style={layerStyle(true)}
				>
				</div>
				<div
					class="absolute inset-0 bg-cover bg-center bg-no-repeat"
					data-bg-layer
					style={layerStyle(false)}
				>
				</div>
			</div>
			<div class="absolute inset-0" style={backgroundOverlayStyle}></div>
			{
				rain.enabled && (
					<canvas
						data-rain-canvas
						data-mode={rain.mode}
						data-density={rain.density}
						data-speed={rain.speed}
						data-drop-color={rain.dropColor}
						data-ripple-color={rain.rippleColor}
						data-max-drops={rain.maxDrops}
						data-max-ripples={rain.maxRipples}
						class="absolute inset-0 h-full w-full"
						aria-hidden="true"
					/>
				)
			}
		</div>
		<Header />
		<main
			class="relative z-10"
			transition:name="page-content"
			transition:animate="slide"
		>
			<slot />
		</main>
		<div class="relative z-10">
			<Footer />
		</div>
	</body>
</html>

<script>
	// Background image carousel
	// 双层图层交叉淡入淡出:下一张先预加载并放到隐藏层,再同步切换透明度,
	// 因此任意时刻都有背景可见,不会出现"无背景"的空白阶段。
	const bgEl = document.querySelector<HTMLElement>("#bg-carousel");
	if (bgEl) {
		const imagesAttr = bgEl.dataset.bgImages;
		const images: string[] = imagesAttr ? JSON.parse(imagesAttr) : [];
		const interval = Number(bgEl.dataset.bgInterval) || 8000;
		const layers = Array.from(
			bgEl.querySelectorAll<HTMLElement>("[data-bg-layer]"),
		);

		if (images.length > 1 && layers.length >= 2) {
			const FADE_MS = 1500;
			const holder = window as unknown as {
				__bgCarouselTimer?: number;
			};
			// 页面间导航后会重新执行本脚本,先清掉旧定时器避免叠加
			if (holder.__bgCarouselTimer !== undefined) {
				window.clearInterval(holder.__bgCarouselTimer);
			}

			const bad = new Set<number>(); // 加载失败的图(如文件不存在)
			let active = 0; // 当前可见图层
			let currentIndex = 0;
			let busy = false;

			const bgUrlOf = (el: HTMLElement): string => {
				const bg = el.style.backgroundImage;
				const match = bg?.match(/url\("(.*)"\)/);
				return match ? match[1] : "";
			};

			// 恢复被 View Transition 保留下来的状态(确定当前实际可见的图)
			const visibleLayer = layers.find(
				(el) => bgUrlOf(el) !== "" && el.style.opacity !== "0",
			);
			if (visibleLayer) {
				active = layers.indexOf(visibleLayer);
				const url = bgUrlOf(visibleLayer);
				const found = images.indexOf(url);
				if (found >= 0) currentIndex = found;
			}
			layers.forEach((el, i) => {
				if (i !== active) el.style.opacity = "0";
			});

			const origOpacity =
				bgEl.dataset.bgOpacity !== undefined
					? bgEl.dataset.bgOpacity
					: "1";

			// 从 from 起找下一个未失效的图片索引,跳过加载失败的图
			const nextValidIndex = (from: number): number => {
				for (let k = 0; k < images.length; k++) {
					const idx = (from + k) % images.length;
					if (!bad.has(idx)) return idx;
				}
				return -1;
			};

			const swapToNext = () => {
				if (busy) return;
				const nextIndex = nextValidIndex(currentIndex + 1);
				if (nextIndex === -1) return; // 全部图片失效,保持当前背景
				busy = true;

				const nextLayer = layers[1 - active];
				const preloader = new Image();
				let settled = false;
				const finish = () => {
					if (!settled) {
						settled = true;
						busy = false;
					}
				};
				// 加载超时兜底,避免 busy 卡死轮播
				const fallback = window.setTimeout(
					finish,
					Math.max(interval, 5000),
				);

				preloader.onload = () => {
					window.clearTimeout(fallback);
					// 新图已就绪,先放到隐藏图层(它此刻透明,不会闪烁),
					// 随后两层同步渐变:旧层淡出、新层淡入
					nextLayer.style.backgroundImage = `url("${images[nextIndex]}")`;
					nextLayer.style.opacity = origOpacity;
					layers[active].style.opacity = "0";
					const previous = active;
					window.setTimeout(() => {
						currentIndex = nextIndex;
						active = 1 - previous;
						finish();
					}, FADE_MS + 80);
				};
				preloader.onerror = () => {
					window.clearTimeout(fallback);
					bad.add(nextIndex);
					finish();
				};
				preloader.src = images[nextIndex];
			};

			// 预热其余图片,保证切换瞬间图片已经在浏览器缓存里
			images.forEach((src, i) => {
				if (i === 0 || bad.has(i)) return;
				const pre = new Image();
				pre.onerror = () => bad.add(i);
				pre.src = src;
			});

			holder.__bgCarouselTimer = window.setInterval(swapToNext, interval);
		}
	}

	const canvas =
		document.querySelector<HTMLCanvasElement>("[data-rain-canvas]");
	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

	if (canvas && !reduceMotion.matches && !canvas.dataset.rainReady) {
		canvas.dataset.rainReady = "true";
		const context = canvas.getContext("2d");
		if (!context) throw new Error("Rain canvas context is unavailable.");

		const mode = canvas.dataset.mode ?? "falling";
		const density = Number(canvas.dataset.density ?? 0.7);
		const speed = Number(canvas.dataset.speed ?? 1);
		const dropColor =
			canvas.dataset.dropColor ?? "rgba(210, 230, 255, 0.5)";
		const rippleColor =
			canvas.dataset.rippleColor ?? "rgba(210, 230, 255, 0.34)";
		const maxDrops = Number(canvas.dataset.maxDrops ?? 170);
		const maxRipples = Number(canvas.dataset.maxRipples ?? 36);
		const fallingDrops: Array<{
			x: number;
			y: number;
			length: number;
			velocity: number;
			alpha: number;
			drift: number;
			impactY: number;
		}> = [];
		const frontDrops: Array<{
			x: number;
			y: number;
			radius: number;
			maxRadius: number;
			velocity: number;
			alpha: number;
			wobble: number;
		}> = [];
		const ripples: Array<{
			x: number;
			y: number;
			radius: number;
			alpha: number;
			growth: number;
			stretch: number;
		}> = [];
		let animationFrame = 0;
		let width = 0;
		let height = 0;
		let pixelRatio = 1;

		const resizeCanvas = () => {
			pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
			width = window.innerWidth;
			height = window.innerHeight;
			canvas.width = Math.floor(width * pixelRatio);
			canvas.height = Math.floor(height * pixelRatio);
			canvas.style.width = `${width}px`;
			canvas.style.height = `${height}px`;
			context?.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
		};

		const spawnFallingDrop = () => {
			if (fallingDrops.length >= maxDrops) return;
			fallingDrops.push({
				x: -width * 0.08 + Math.random() * width * 1.16,
				y: -height * 0.18 - Math.random() * 80,
				length: 16 + Math.random() * 28,
				velocity: (9 + Math.random() * 8) * speed,
				alpha: 0.22 + Math.random() * 0.42,
				drift: -2.6 - Math.random() * 2.2,
				impactY: Math.random() * height,
			});
		};

		const spawnFrontDrop = () => {
			if (frontDrops.length >= maxDrops) return;
			frontDrops.push({
				x: Math.random() * width,
				y: Math.random() * height,
				radius: 0.4 + Math.random() * 1.8,
				maxRadius: 10 + Math.random() * 7,
				velocity: (0.22 + Math.random() * 0.44) * speed,
				alpha: 0.08 + Math.random() * 0.22,
				wobble: Math.random() * Math.PI * 2,
			});
		};

		const spawnRipple = (
			x: number,
			y: number,
			velocity: number,
			stretch = 1.8,
		) => {
			if (ripples.length > maxRipples) ripples.shift();
			ripples.push({
				x,
				y,
				radius: 2,
				alpha: Math.min(0.42, 0.16 + velocity / 60),
				growth: 0.9 + Math.random() * 0.65,
				stretch,
			});
		};

		const drawFallingRain = () => {
			const spawnCount = Math.max(2, Math.round(density * 8));
			for (let index = 0; index < spawnCount; index += 1) {
				if (Math.random() < density * 0.52) spawnFallingDrop();
			}

			for (let index = fallingDrops.length - 1; index >= 0; index -= 1) {
				const drop = fallingDrops[index];
				drop.y += drop.velocity;
				drop.x += drop.drift;
				context.save();
				context.globalAlpha = drop.alpha;
				context.strokeStyle = dropColor;
				context.lineWidth = 1;
				context.beginPath();
				context.moveTo(drop.x, drop.y);
				context.lineTo(drop.x + drop.drift * 1.8, drop.y + drop.length);
				context.stroke();
				context.restore();

				if (
					drop.y >= drop.impactY ||
					drop.y > height + 80 ||
					drop.x < -120
				) {
					spawnRipple(
						drop.x,
						Math.max(8, Math.min(drop.y + drop.length, height - 8)),
						drop.velocity,
						1.9,
					);
					fallingDrops.splice(index, 1);
				}
			}
		};

		const drawFrontRain = () => {
			const spawnCount = Math.max(2, Math.round(density * 6));
			for (let index = 0; index < spawnCount; index += 1) {
				if (Math.random() < density * 0.38) spawnFrontDrop();
			}

			for (let index = frontDrops.length - 1; index >= 0; index -= 1) {
				const drop = frontDrops[index];
				drop.radius += drop.velocity;
				drop.alpha += 0.008 * speed;
				drop.wobble += 0.035;
				const offsetX = Math.cos(drop.wobble) * drop.radius * 0.08;
				const offsetY = Math.sin(drop.wobble) * drop.radius * 0.08;

				context.save();
				context.globalAlpha = Math.min(drop.alpha, 0.5);
				context.strokeStyle = dropColor;
				context.lineWidth = 1;
				context.beginPath();
				context.arc(
					drop.x + offsetX,
					drop.y + offsetY,
					drop.radius,
					0,
					Math.PI * 2,
				);
				context.stroke();
				context.restore();

				if (drop.radius > drop.maxRadius) {
					spawnRipple(drop.x, drop.y, drop.radius * 2.2, 1);
					frontDrops.splice(index, 1);
				}
			}
		};

		const drawRipples = () => {
			for (let index = ripples.length - 1; index >= 0; index -= 1) {
				const ripple = ripples[index];
				ripple.radius += ripple.growth;
				ripple.alpha *= 0.965;
				context.save();
				context.globalAlpha = ripple.alpha;
				context.strokeStyle = rippleColor;
				context.lineWidth = 1;
				context.beginPath();
				context.ellipse(
					ripple.x,
					ripple.y,
					ripple.radius * ripple.stretch,
					ripple.radius * 0.48,
					0,
					0,
					Math.PI * 2,
				);
				context.stroke();
				context.restore();

				if (ripple.alpha < 0.015 || ripple.radius > 56) {
					ripples.splice(index, 1);
				}
			}
		};

		const draw = () => {
			context.clearRect(0, 0, width, height);

			if (mode === "front") drawFrontRain();
			else drawFallingRain();
			drawRipples();

			animationFrame = window.requestAnimationFrame(draw);
		};

		resizeCanvas();
		window.addEventListener("resize", resizeCanvas);
		animationFrame = window.requestAnimationFrame(draw);

		reduceMotion.addEventListener("change", (event) => {
			if (event.matches) {
				window.cancelAnimationFrame(animationFrame);
				context?.clearRect(0, 0, width, height);
			} else {
				animationFrame = window.requestAnimationFrame(draw);
			}
		});
	}
</script>
