---
import { Marked } from "marked";
import SectionHeading from "./SectionHeading.astro";

type GameItem = {
	label: string;
	description?: string;
	content?: string;
	gameId?: number | string;
	href?: string;
	icon?: string;
};

interface Props {
	title: string;
	description?: string;
	items: Array<string | GameItem>;
}

const { description, items, title } = Astro.props;
const games = items.map((item) =>
	typeof item === "string" ? { label: item } : item,
);

const marked = new Marked({ gfm: true, breaks: true });
const renderedItems = await Promise.all(
	games.map(async (game) => ({
		...game,
		renderedLabel: await marked.parseInline(game.label),
		renderedDescription: game.description ? await marked.parse(game.description) : null,
		renderedContent: game.content ? await marked.parse(game.content) : null,
	})),
);
---

<section class="mx-auto max-w-6xl px-5 py-16">
	<SectionHeading title={title} description={description} />
	<div class="mx-auto flex max-w-4xl flex-col gap-6">
		{
			renderedItems.map((game) => (
				<div class="rounded-xl border border-white/10 bg-white/[0.03] p-6 transition hover:border-white/25 hover:bg-white/[0.06]">
					<h3
						class="text-2xl font-semibold text-white [&_a]:text-blue-400 [&_a:hover]:text-blue-300 [&_code]:rounded [&_code]:bg-white/5 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-xs [&_strong]:font-semibold [&_strong]:text-white"
						set:html={game.renderedLabel}
					/>
					{game.renderedDescription && (
						<div
							class="mt-2 text-sm leading-6 text-zinc-400 [&_a]:text-blue-400 [&_a:hover]:text-blue-300 [&_code]:rounded [&_code]:bg-white/5 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-xs [&_strong]:font-semibold [&_strong]:text-white [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:mt-1 [&_blockquote]:border-l-2 [&_blockquote]:border-blue-400/30 [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-zinc-400 [&_hr]:border-white/10"
							set:html={game.renderedDescription}
						/>
					)}
					{game.renderedContent && (
						<div
							class="prose-content mt-4 space-y-3 text-sm leading-6 text-zinc-300 [&_a]:text-blue-400 [&_a:hover]:text-blue-300 [&_code]:rounded [&_code]:bg-white/5 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-xs [&_strong]:font-semibold [&_strong]:text-white [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:mt-1 [&_blockquote]:border-l-2 [&_blockquote]:border-blue-400/30 [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-zinc-400 [&_hr]:border-white/10"
							set:html={game.renderedContent}
						/>
					)}
				</div>
			))
		}
	</div>
</section>
